<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: property.address + ' — Home Passport' }) %></head>
<body>
<div class="app-shell">

  <div style="position:relative;height:236px;flex-shrink:0;background:linear-gradient(135deg, #1c1a1d 0%, #2a1810 100%);display:flex;flex-direction:column;justify-content:space-between;padding:20px 20px 18px 20px;border-bottom:1px solid var(--border);">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;">
      <div style="display:flex;align-items:center;gap:7px;background:rgba(0,0,0,0.35);border:1px solid var(--orange);padding:6px 12px 6px 8px;border-radius:100px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF6A00" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        <span style="font-size:12px;font-weight:600;letter-spacing:0.02em;color:var(--text);">Verified Home Passport</span>
      </div>
    </div>
    <div>
      <h1 style="font-size:27px;font-weight:700;color:var(--text);line-height:1.15;"><%= property.address %></h1>
      <div style="font-size:13px;color:var(--text-dim);margin-top:3px;"><%= property.suburb %> &nbsp;&middot;&nbsp; Built <%= property.builtYear %></div>
    </div>
  </div>

  <div style="padding:18px 20px 0 20px;">
    <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:22px;">
      <div class="card" style="padding:12px 10px;text-align:center;">
        <div style="font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;color:var(--orange);"><%= ageYears %></div>
        <div style="font-size:11px;color:var(--text-dim);margin-top:2px;">Years old</div>
      </div>
      <div class="card" style="padding:12px 10px;text-align:center;">
        <div style="font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;color:var(--orange);"><%= property.lastRenovationYear %></div>
        <div style="font-size:11px;color:var(--text-dim);margin-top:2px;">Last reno</div>
      </div>
      <div class="card" style="padding:12px 10px;text-align:center;">
        <div style="font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;color:var(--orange);"><%= totalRecords %></div>
        <div style="font-size:11px;color:var(--text-dim);margin-top:2px;">Records</div>
      </div>
    </div>

    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <h2 style="font-size:18px;font-weight:700;">Records</h2>
      <span style="font-size:12px;color:var(--text-dim);">Tap a category</span>
    </div>

    <div style="display:flex;flex-direction:column;gap:10px;">
      <% categories.forEach(function(cat) { %>
        <a href="/category/<%= cat.slug %>" aria-label="Open <%= cat.label %> records" class="card" style="display:flex;align-items:center;gap:14px;padding:14px;">
          <div class="icon-circle" style="width:44px;height:44px;">
            <%- include('partials/icon', { name: cat.icon, color: '#FF6A00', size: 20 }) %>
          </div>
          <div style="flex:1;">
            <div style="font-size:15px;font-weight:600;color:var(--text);"><%= cat.label %></div>
            <div style="font-size:12px;color:var(--text-dim);margin-top:1px;"><%= cat.count %> record<%= cat.count === 1 ? '' : 's' %></div>
          </div>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-dim)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
        </a>
      <% }); %>
    </div>
  </div>

  <nav class="bottom-nav">
    <a href="/" class="active" aria-label="Home">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
      Home
    </a>
    <a href="/add" aria-label="Add a record">
      <span class="fab">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#14100A" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </span>
    </a>
    <a href="/share" aria-label="Share this passport">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.6" y1="10.6" x2="15.4" y2="6.4"/><line x1="8.6" y1="13.4" x2="15.4" y2="17.6"/></svg>
      Share
    </a>
  </nav>

</div>
</body>
</html>
