<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: 'Share — Home Passport' }) %></head>
<body>
<div class="app-shell">

  <div style="padding:28px 20px 16px 20px;display:flex;align-items:center;gap:14px;">
    <a href="/" aria-label="Back" class="card" style="width:36px;height:36px;border-radius:100px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </a>
    <h1 style="font-size:20px;font-weight:700;color:var(--text);">Share this passport</h1>
  </div>

  <div style="padding:6px 20px 0 20px;">
    <p style="font-size:13px;color:var(--text-dim);line-height:1.5;margin-bottom:18px;">
      This is the link the NFC tag opens. Anyone with the link — or a tap of the card — can view <%= property.address %>'s records.
    </p>
    <div class="card" style="display:flex;align-items:center;gap:10px;padding:14px;margin-bottom:12px;">
      <span id="share-url" style="flex:1;font-size:13px;word-break:break-all;color:var(--text);"><%= url %></span>
    </div>
    <button id="copy-btn" class="btn-primary" type="button">Copy link</button>

    <a href="/export" class="card" style="display:flex;align-items:center;gap:12px;padding:14px;margin-top:24px;">
      <div class="icon-circle" style="width:40px;height:40px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF6A00" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      </div>
      <div>
        <div style="font-size:14px;font-weight:600;color:var(--text);">Export everything</div>
        <div style="font-size:12px;color:var(--text-dim);">Download a zip of all records &amp; files</div>
      </div>
    </a>
  </div>

</div>
<script>
  document.getElementById('copy-btn').addEventListener('click', function () {
    navigator.clipboard.writeText(document.getElementById('share-url').textContent.trim())
      .then(function () {
        var btn = document.getElementById('copy-btn');
        var original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(function () { btn.textContent = original; }, 1500);
      });
  });
</script>
</body>
</html>
