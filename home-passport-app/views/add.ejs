<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title: 'Add a record — Home Passport' }) %></head>
<body>
<div class="app-shell" style="padding-bottom:40px;">

  <div style="padding:28px 20px 16px 20px;display:flex;align-items:center;gap:14px;">
    <a href="/category/<%= selected.slug %>" aria-label="Cancel and go back" style="width:36px;height:36px;border-radius:100px;background:#ffffff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16141A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </a>
    <h1 style="font-size:20px;font-weight:600;">Add a record</h1>
  </div>

  <form id="add-form" style="padding:6px 20px 0 20px;" enctype="multipart/form-data">

    <div style="font-size:12px;font-weight:600;color:#6b6558;margin-bottom:8px;">CATEGORY</div>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px;" id="category-chips">
      <% categories.forEach(function(cat) { %>
        <button type="button" class="chip <%= cat.slug === selected.slug ? 'selected' : '' %>" data-slug="<%= cat.slug %>"><%= cat.label %></button>
      <% }); %>
    </div>
    <input type="hidden" name="category" id="category-input" value="<%= selected.slug %>">

    <div style="font-size:12px;font-weight:600;color:#6b6558;margin-bottom:8px;">ADD PHOTO OR DOCUMENT</div>
    <label for="photo-input" style="display:block;border:2px dashed #cbbfa0;border-radius:16px;padding:26px 20px;text-align:center;margin-bottom:16px;background:rgba(255,255,255,0.4);cursor:pointer;">
      <div class="icon-circle" style="width:44px;height:44px;margin:0 auto 10px auto;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FF6A00" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      </div>
      <div id="photo-label" style="font-size:13px;font-weight:600;">Tap to take a photo or upload</div>
      <div style="font-size:11px;color:#6b6558;margin-top:2px;">JPG, PNG or PDF · up to 20MB</div>
    </label>
    <input type="file" id="photo-input" name="photo" accept="image/*,application/pdf" style="display:none;">

    <button type="button" id="voice-btn" style="width:100%;display:flex;align-items:center;gap:12px;background:#ffffff;border:none;border-radius:16px;padding:14px;margin-bottom:22px;cursor:pointer;">
      <div id="voice-icon-wrap" style="width:40px;height:40px;border-radius:100px;background:#16141A;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F6F1E4" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/></svg>
      </div>
      <div style="text-align:left;">
        <div id="voice-title" style="font-size:14px;font-weight:600;">Record a voice note</div>
        <div id="voice-subtitle" style="font-size:11px;color:#6b6558;">Handy for quick context on the go</div>
      </div>
    </button>
    <audio id="voice-preview" controls style="width:100%;display:none;margin:-14px 0 22px 0;"></audio>

    <div style="font-size:12px;font-weight:600;color:#6b6558;margin-bottom:8px;">TITLE</div>
    <input type="text" name="title" id="title-input" placeholder="e.g. Hot water cylinder install" required
      style="width:100%;box-sizing:border-box;background:#ffffff;border:1px solid #e5ddc8;border-radius:12px;padding:14px;font-size:14px;margin-bottom:16px;">

    <label for="notes-field" style="font-size:12px;font-weight:600;color:#6b6558;display:block;margin-bottom:8px;">NOTES</label>
    <textarea id="notes-field" name="notes" placeholder="Any details worth keeping — brand, date, who did the work..." rows="4"
      style="width:100%;box-sizing:border-box;background:#ffffff;border:1px solid #e5ddc8;border-radius:12px;padding:14px;font-size:14px;resize:none;margin-bottom:22px;"></textarea>

    <div id="error-msg" style="display:none;color:#c24f00;font-size:13px;margin-bottom:12px;"></div>

    <button type="submit" class="btn-primary" id="save-btn">Save record</button>
  </form>

</div>
<script src="/add.js"></script>
</body>
</html>
